<% content_for :title, "ToDoの編集" %>

<h1>ToDoの編集</h1>

<%= form_with model: @todo do |form| %>
  <%= render "shared/errors", record: @todo %>

  <div>
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title, **(title_limit_enabled? ? { maxlength: 100 } : {}) %>
  </div>

  <% if due_feature_enabled? %>
    <div>
      <%= form.label :due_on, "期限" %>
      <%= form.date_field :due_on %>
    </div>

  <% end %>
  <div>
    <%= form.submit "保存" %>
  </div>
<% end %>

<p><%= link_to "リストへ戻る", @todo.list %></p>
