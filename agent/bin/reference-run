#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "optparse"
require "agent/config"
require "agent/reference/claude_code"
require "agent/runner"
require "agent/scenario"

options = { runs: 1 }
parser = OptionParser.new do |opts|
  opts.banner = "使い方: bin/reference-run --scenario s2 --condition html [--runs 3]"
  opts.on("--scenario ID", "シナリオ（s0〜s4）") { |v| options[:scenario] = v }
  opts.on("--condition NAME", "条件（html / json / json_v2）") { |v| options[:condition] = v }
  opts.on("--runs N", Integer, "繰り返し回数（既定 1。参考実行は 3〜5 に抑える）") { |v| options[:runs] = v }
  opts.on("--model ID", "モデル") { |v| options[:model] = v }
  opts.on("--port N", Integer, "ポート（既定 3000）") { |v| options[:port] = v }
  opts.on("-h", "--help") { puts opts; exit }
end
parser.parse!

unless options[:scenario]
  warn parser.banner
  exit 1
end

config = Agent::Config.default(agent_name: "claude_code")
config.model = options[:model] if options[:model]
config.port = options[:port] if options[:port]

factory = lambda do |scenario:, condition:, origin:, transcript:, config:, run_dir:, **|
  Agent::Reference::ClaudeCode.new(
    scenario: scenario, condition: condition, origin: origin, transcript: transcript,
    config: config, app_dir: Agent::Runner::TODO_APP_DIR, run_dir: run_dir
  )
end

scenario = Agent::Scenario.load(options[:scenario])
names = options[:condition] ? [ options[:condition] ] : scenario.condition_names

names.each do |condition_name|
  runner = Agent::Runner.new(
    scenario: scenario, condition_name: condition_name, config: config,
    agent_factory: factory, build_initial_message: false
  )
  options[:runs].times do |index|
    data = runner.call(sequence: index + 1)
    puts format(
      "%-42s %-14s requests=%-3d errors=%-2d turns=%-3s cost=%s",
      data["run_id"], data["verdict"], data["http_requests"], data["error_responses"],
      data["num_turns"], data["total_cost_usd"]
    )
  end
end
