<% content_for :title, @list.name %>

<h1><%= @list.name %></h1>

<% if @list.archived? %>
  <p>アーカイブ済み</p>
<% end %>

<p>
  <%= link_to "編集", edit_list_path(@list) %>
  <%= button_to "削除", @list, method: :delete %>
  <% if archive_feature_enabled? %>
    <% if @list.archived? %>
      <%= button_to "アーカイブを解除", list_archive_path(@list), method: :delete %>
    <% else %>
      <%= button_to "アーカイブ", list_archive_path(@list), method: :post %>
    <% end %>
  <% end %>
</p>

<h2>ToDo</h2>

<ul>
  <% @todos.each do |todo| %>
    <li><%= render "todos/todo", todo: todo %></li>
  <% end %>
</ul>

<% if @list.archived? %>
  <p>このリストはアーカイブ済みです。ToDoは追加できません。</p>
<% else %>
  <h2>ToDoを追加</h2>
  <%= form_with model: [ @list, Todo.new ] do |form| %>
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
    <%= form.submit "追加" %>
  <% end %>
<% end %>

<p><%= link_to "リスト一覧へ", lists_path %></p>
